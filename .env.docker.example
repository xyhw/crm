# Docker 部署环境变量（复制为 .env 后填写，.env 已被 gitignore）
MYSQL_ROOT_PASSWORD=change-me-root
DB_PASS=change-me-db
JWT_SECRET=change-me-jwt
REFRESH_SECRET=change-me-refresh
ADMIN_SECRET=change-me-admin

# 首次部署创建默认管理员的初始密码（强烈建议设置，避免使用默认 admin123）
ADMIN_INIT_PASSWORD=

# 邮件配置（找回密码验证码；log=只打印到 api 日志仅供调试，上线必须 smtp）
MAIL_PROVIDER=smtp
MAIL_FROM=noreply@example.com
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=465
MAIL_SMTP_USER=
MAIL_SMTP_PASS=

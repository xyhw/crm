# Docker 部署环境变量（复制为 .env 后填写，.env 已被 gitignore）
# 除 MYSQL_ROOT_PASSWORD / DB_PASS / JWT_SECRET / REFRESH_SECRET / ADMIN_SECRET 必填外，
# 其余留空均会回落到服务端代码默认值，不影响启动。

# ── 必填：数据库与密钥 ──
MYSQL_ROOT_PASSWORD=change-me-root
DB_PASS=change-me-db
JWT_SECRET=change-me-jwt
REFRESH_SECRET=change-me-refresh
ADMIN_SECRET=change-me-admin

# 首次部署创建默认管理员的初始密码（强烈建议设置，避免使用默认 admin123）
ADMIN_INIT_PASSWORD=

# 跨域来源白名单（逗号分隔，如 https://example.com,https://admin.example.com）
# 留空则允许任意来源（仅限开发环境）；生产建议填写正式域名
CORS_ORIGINS=

# ── 邮件（找回密码验证码；log=只打印到 api 日志仅供调试，上线必须 smtp） ──
MAIL_PROVIDER=smtp
MAIL_FROM=noreply@example.com
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true
MAIL_SMTP_USER=
MAIL_SMTP_PASS=

# ── 微信小程序凭据（不配则小程序微信登录/手机号授权自动降级，手机号+密码登录不受影响） ──
# 微信公众平台 mp.weixin.qq.com「设置-基本信息的 AppID」，与 miniapp/src/manifest.json 一致
WX_MINIAPP_APPID=
# 「开发管理-开发设置」的 AppSecret
WX_MINIAPP_SECRET=

# ── 支付通用 ──
# 默认充值渠道（mock/waffo/wechat/alipay/stripe）；渠道总开关在后台「系统配置」里设置
PAY_DEFAULT_CHANNEL=mock
# 对外公网地址（https://<你的域名>），webhook 回调与收银台回跳需要
PAY_SITE_BASE_URL=
# 1 积分可兑换金额（元），默认 1 积分 = 1 元
PAY_POINTS_TO_YUAN=
# 未支付订单过期时间（秒），默认 1800（30 分钟）
PAY_ORDER_TTL=
# 开发环境 mock 渠道是否自动完成支付（生产环境 mock 渠道不可用）
PAY_MOCK_AUTOPAY=

# ── 微信虚拟支付（小程序端充值；个人主体小程序「虚拟支付」能力） ──
# 开通见 miniapp/DEPLOY-CHECKLIST.md；后台需同时开启 pay_wechat_enabled
PAY_WECHAT_APPID=
# MP 后台「虚拟支付-基本配置」OfferID
PAY_WECHAT_OFFER_ID=
# 虚拟支付环境：0=正式（默认），1=沙箱
PAY_WECHAT_ENV=0
PAY_WECHAT_APPKEY=
PAY_WECHAT_PUSH_TOKEN=
# 道具直购映射（JSON 字符串，如 {"1":{"productId":"prod_xxx","name":"积分礼包1"}}）
PAY_WECHAT_PRODUCT_MAP=
# 以下仅 JSAPI 支付需要（虚拟支付可留空）
PAY_WECHAT_MCHID=
PAY_WECHAT_SERIALNO=
PAY_WECHAT_APIV3KEY=
PAY_WECHAT_PRIVATE_KEY_PATH=
PAY_WECHAT_NOTIFY_URL=

# ── Waffo 托管收银台（H5 端充值；后台需同时开启 pay_waffo_enabled） ──
PAY_WAFFO_ENVIRONMENT=
PAY_WAFFO_MERCHANT_ID=
PAY_WAFFO_STORE_ID=
PAY_WAFFO_PRODUCT_ID=
PAY_WAFFO_PRIVATE_KEY=
PAY_WAFFO_CURRENCY=CNY
# 支付完成回跳地址（https://<你的域名>/pay-result 之类）
PAY_WAFFO_SUCCESS_URL=

# ── 支付宝 / Stripe（可选渠道，未接入留空） ──
PAY_ALIPAY_APPID=
PAY_ALIPAY_PRIVATE_KEY=
PAY_ALIPAY_PUBLIC_KEY=
PAY_ALIPAY_NOTIFY_URL=
PAY_STRIPE_SECRET_KEY=
PAY_STRIPE_WEBHOOK_SECRET=

# ── 风控调参（留空用代码默认：登录限流 10 次/60s，接口限流 300 次/60s，账号锁定 5 次/15 分钟） ──
RATE_LIMIT_LOGIN_MAX=
RATE_LIMIT_LOGIN_WINDOW_MS=
RATE_LIMIT_API_MAX=
RATE_LIMIT_API_WINDOW_MS=
ACCOUNT_LOCK_THRESHOLD=
ACCOUNT_LOCK_WINDOW_SEC=

# ── 重新打包镜像版本 tag（不设置则 tag 为 latest） ──
APP_VERSION=latest

# Docker 部署环境变量（复制为 .env 后填写，.env 已被 gitignore）
MYSQL_ROOT_PASSWORD=change-me-root
DB_PASS=change-me-db
JWT_SECRET=change-me-jwt
REFRESH_SECRET=change-me-refresh
ADMIN_SECRET=change-me-admin

# 邮件配置（找回密码验证码；log=打印日志，smtp=真实发送）
MAIL_PROVIDER=log
MAIL_FROM=noreply@localhost
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_USER=
MAIL_SMTP_PASS=

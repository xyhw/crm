# ===== 数据库（必改）=====
MYSQL_ROOT_PASSWORD=change_me_root_password
DB_PASS=change_me_db_password

# ===== JWT/鉴权密钥（必改，用 openssl rand -hex 32 生成）=====
JWT_SECRET=change_me_jwt_secret
REFRESH_SECRET=change_me_refresh_secret
ADMIN_SECRET=change_me_admin_secret

# ===== admin 初始密码（首次登录后立即修改）=====
ADMIN_INIT_PASSWORD=change_me_admin_password

# ===== CORS（改成真实前端域名，逗号分隔）=====
CORS_ORIGINS=https://yourdomain.com

# ===== 邮件（默认 log 仅打印到日志；生产改 smtp）=====
MAIL_PROVIDER=log
MAIL_FROM=noreply@localhost
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_USER=
MAIL_SMTP_PASS=

# ===== 前端 API 地址（同源部署默认留空，走 nginx 反代 /api）=====
VITE_API_BASE=

# ===== 微信小程序（登录 jscode2session 用，必填才能微信登录）=====
WX_MINIAPP_APPID=
WX_MINIAPP_SECRET=

# ===== 微信小程序虚拟支付（积分充值；MP 后台虚拟支付->基本配置/道具管理获取）=====
PAY_WECHAT_APPID=
# OfferID（虚拟支付 -> 基本配置）
PAY_WECHAT_OFFER_ID=
# 现网 AppKey（沙箱联调时先填沙箱 AppKey 并设 PAY_WECHAT_ENV=1）
PAY_WECHAT_APPKEY=
# 0=现网 1=沙箱
PAY_WECHAT_ENV=0
# 积分数 -> 道具ID，JSON。须与道具管理价格一致（3 档：50/100/200）
PAY_WECHAT_PRODUCT_MAP={"50":"your_product_id_50","100":"your_product_id_100","200":"your_product_id_200"}
# MP 后台消息推送 Token（发货通知验签用）
PAY_WECHAT_PUSH_TOKEN=
# 发货通知回调地址（MP 后台消息推送 URL，须公网 HTTPS 可达）
PAY_WECHAT_NOTIFY_URL=https://your-domain/api/points/recharge/notify/wechat

# ===== 充值档位（积分数，逗号分隔；须与前端档位一致）=====
POINTS_RECHARGE_TIERS=50,100,200
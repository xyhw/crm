# ===== 数据库（必改）=====
MYSQL_ROOT_PASSWORD=change_me_root_password
DB_PASS=change_me_db_password

# ===== JWT/鉴权密钥（必改，用 openssl rand -hex 32 生成）=====
JWT_SECRET=change_me_jwt_secret
REFRESH_SECRET=change_me_refresh_secret
ADMIN_SECRET=change_me_admin_secret

# ===== admin 初始密码（首次登录后立即修改）=====
ADMIN_INIT_PASSWORD=change_me_admin_password

# ===== CORS（改成真实前端域名，逗号分隔）=====
CORS_ORIGINS=https://yourdomain.com

# ===== 邮件（默认 log 仅打印到日志；生产改 smtp）=====
MAIL_PROVIDER=log
MAIL_FROM=noreply@localhost
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_USER=
MAIL_SMTP_PASS=

# ===== 前端 API 地址（同源部署默认留空，走 nginx 反代 /api）=====
VITE_API_BASE=
# 数据库配置
DB_HOST=localhost
DB_USER=hof_user
DB_PASS=hof_pass_2026
DB_NAME=hotel_order_follow

# JWT 密钥（生产环境必须显式设置，禁止使用默认值）
JWT_SECRET=your-strong-jwt-secret-here
REFRESH_SECRET=your-strong-refresh-secret-here
ADMIN_SECRET=your-strong-admin-secret-here

# 服务端口
PORT=3001

# 运行环境: development | production
NODE_ENV=development

# 上传目录
UPLOAD_DIR=/workspace/uploads

# 微信小程序登录
WX_MINIAPP_APPID=
WX_MINIAPP_SECRET=

# 微信虚拟支付（个人主体道具直购）
# MP后台：支付与交易 → 虚拟支付 → 基本配置
PAY_WECHAT_APPID=
PAY_WECHAT_OFFER_ID=
PAY_WECHAT_APPKEY=
# 积分数 -> 已发布道具ID，JSON。须与道具管理价格一致（单位分=积分*PAY_POINTS_TO_YUAN*100）
PAY_WECHAT_PRODUCT_MAP={"50":"your_product_id_50","100":"your_product_id_100"}
PAY_WECHAT_ENV=1
PAY_WECHAT_PUSH_TOKEN=
PAY_WECHAT_NOTIFY_URL=https://your-domain/api/points/recharge/notify/wechat

# 限流配置（毫秒/次数）
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_LOGIN_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=30

# 邮件配置（找回密码验证码）
# log: 开发环境验证码打印到服务端日志；smtp: 真实发送
MAIL_PROVIDER=log
MAIL_FROM=noreply@localhost
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true
MAIL_SMTP_USER=
MAIL_SMTP_PASS=